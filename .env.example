# ─── API ─────────────────────────────────────────────────────────────
# In production: set to your Render backend URL + /api/
# e.g. https://kurti-cove-api.onrender.com/api/
NEXT_PUBLIC_API_BASE_URL=https://your-render-app.onrender.com/api/

# ─── UPI Payments ────────────────────────────────────────────────────
# Your store's UPI handle (e.g. storename@okaxis)
NEXT_PUBLIC_STORE_UPI_ID=yourstore@upi
NEXT_PUBLIC_STORE_NAME=Kurti Cove
